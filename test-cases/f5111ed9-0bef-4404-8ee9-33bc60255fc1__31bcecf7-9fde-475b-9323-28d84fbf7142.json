{
  "id": "31bcecf7-9fde-475b-9323-28d84fbf7142",
  "testPlanId": "f5111ed9-0bef-4404-8ee9-33bc60255fc1",
  "requirementId": "ae1d1ba2-a2de-4894-beb9-bf19409b3f4c",
  "suiteName": "demo31 — Product Inventory and Cart (Sauce Demo)",
  "case": {
    "id": "31bcecf7-9fde-475b-9323-28d84fbf7142",
    "title": "Checkout with items navigates to Checkout: Your Information page",
    "priority": "P0",
    "platforms": [
      "chrome"
    ],
    "preconditions": [
      "User has valid credentials: standard_user / secret_sauce; At least one item to checkout"
    ],
    "steps": [
      {
        "id": "s1",
        "action": "openUrl",
        "targetDescription": "Open login page",
        "value": "https://www.saucedemo.com/"
      },
      {
        "id": "s2",
        "action": "fill",
        "targetDescription": "Username",
        "locatorHint": "#user-name",
        "value": "standard_user"
      },
      {
        "id": "s3",
        "action": "fill",
        "targetDescription": "Password",
        "locatorHint": "#password",
        "value": "secret_sauce"
      },
      {
        "id": "s4",
        "action": "tap",
        "targetDescription": "Login",
        "locatorHint": "#login-button"
      },
      {
        "id": "s5",
        "action": "tap",
        "targetDescription": "Add Backpack",
        "locatorHint": "button[data-test='add-to-cart-sauce-labs-backpack']"
      },
      {
        "id": "s6",
        "action": "tap",
        "targetDescription": "Open cart",
        "locatorHint": ".shopping_cart_link"
      },
      {
        "id": "s7",
        "action": "tap",
        "targetDescription": "Checkout button",
        "locatorHint": "[data-test='checkout']"
      },
      {
        "id": "s8",
        "action": "assertContainsText",
        "targetDescription": "Checkout information page title",
        "locatorHint": ".title",
        "assertion": "Checkout: Your Information"
      }
    ],
    "tags": [
      "@functional",
      "@regression"
    ]
  }
}
